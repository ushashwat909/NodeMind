# Supabase Configuration
# SUPABASE_URL: URL of your Supabase project (e.g. https://your-ref.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: Client/public anon key (used for user-scoped clients & token verification)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SUPABASE_SERVICE_ROLE_KEY: Secret service role key (only on server, never sent to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
